---
import type { HTMLAttributes } from "astro/types";
import config from "@/config";

type Props = {
  noMarginTop?: boolean;
} & HTMLAttributes<"footer">;

const { noMarginTop = false, class: className, ...attrs } = Astro.props;

const currentYear = new Date().getFullYear();
---

<footer
  class:list={["site-footer", { "mt-auto": !noMarginTop }, className]}
  {...attrs}
>
  <div class="footer-inner">
    <span>&#169; {currentYear} {config.site.title} · 随笔与技术笔记</span>
    <nav class="footer-links" aria-label="页脚导航">
      <a href="/rss.xml">RSS 订阅</a>
      <a href={config.site.profile}>GitHub</a>
      <a href="/games/">小实验</a>
    </nav>
  </div>
</footer>
