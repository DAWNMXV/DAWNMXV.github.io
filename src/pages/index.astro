---
import { getCollection } from "astro:content";
import { getRelativeLocaleUrl } from "astro:i18n";
import Layout from "@/layouts/Layout.astro";
import Header from "@/components/Header.astro";
import Footer from "@/components/Footer.astro";
import BlogProfile from "@/components/BlogProfile.astro";
import Card from "@/components/Card.astro";
import { getSortedPosts } from "@/utils/getSortedPosts";
import config from "@/config";

const locale = Astro.currentLocale ?? config.site.lang;
const sortedPosts = getSortedPosts(await getCollection("posts"));
const featuredPosts = sortedPosts.filter(({ data }) => data.featured);
const recentPosts = sortedPosts.filter(({ data }) => !data.featured);
const homePath = getRelativeLocaleUrl(locale, "");
---

<Layout>
  <Header />
  <main
    id="main-content"
    data-layout="index"
    data-home-path={homePath}
    class="home-layout"
  >
    <section id="hero" class="home-intro">
      <p class="home-eyebrow">DAWNMX 的个人博客</p>
      <h1>生活与思考</h1>
      <p>随笔、诗歌与数字验证笔记。把值得记下的事，慢慢写下来。</p>
      <nav class="home-topics" aria-label="博客内容">
        <a href="/series/digital-verification/">数字验证问答 <span>→</span></a>
        <a href="/posts/">全部文章 <span>→</span></a>
      </nav>
    </section>
    <div class="home-columns">
      <div class="home-posts">
        {
          featuredPosts.length > 0 && (
            <section id="featured" class="home-panel">
              <>
                <h2 class="section-label">置顶文章</h2>
                <ul>
                  {featuredPosts.map(data => (
                    <Card variant="h3" {...data} />
                  ))}
                </ul>
              </>
            </section>
          )
        }
        <section id="recent-posts" class="home-panel">
          <div class="section-heading">
            <h2 class="section-label">最近更新</h2><a href="/archives/"
              >按时间浏览 →</a
            >
          </div>
          <ul>
            {
              recentPosts
                .slice(0, config.posts.perIndex)
                .map(data => <Card variant="h3" {...data} />)
            }
          </ul>
          <a class="all-posts-link" href={getRelativeLocaleUrl(locale, "posts")}
            >查看全部 {sortedPosts.length} 篇文章 →</a
          >
        </section>
      </div>
      <BlogProfile />
    </div>
  </main>
  <Footer />
</Layout>

<script>
  document.addEventListener("astro:page-load", () => {
    const indexLayout = (document.querySelector("#main-content") as HTMLElement)
      ?.dataset;
    const baseRoot = import.meta.env.BASE_URL.replace(/\/?$/, "/");
    if (indexLayout?.layout) {
      sessionStorage.setItem("backUrl", indexLayout.homePath ?? baseRoot);
    }
  });
</script>
